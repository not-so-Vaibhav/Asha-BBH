# Server-side only. Never add the VITE_ prefix to any secret.
GNANI_API_KEY_ID=

# Timbre v3.0 uses multilingual voices (Shivani supports en-IN, hi-IN, mr-IN).
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
# Optional per-language Timbre voice overrides (leave blank to use GNANI_TTS_VOICE):
# GNANI_TTS_VOICE_EN=Shivani
# GNANI_TTS_VOICE_HI=Shivani
# GNANI_TTS_VOICE_MR=Shivani

# ── Supabase (Client-safe public keys — set in .env.local and Vercel) ────────
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=
# Optional CAPTCHA site key (Cloudflare Turnstile or hCaptcha) for sign-up & anonymous demo:
# VITE_TURNSTILE_SITE_KEY=

# ── Supabase Server Verification (Server-side only; NEVER prefix with VITE_) ─
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# Optional HS256 JWT secret (only needed if your project uses legacy HS256 instead of JWKS):
# SUPABASE_JWT_SECRET=
# Set to "true" to enforce JWT auth on /api/gnani/* in local dev; production always enforces auth.
# REQUIRE_AUTH=true

# ── Optional shared cross-instance rate limiter (Vercel KV / Upstash Redis) ──
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# GNANI_TTS_RATE_LIMIT=60
# GNANI_TTS_USER_RATE_LIMIT=60
# GNANI_STT_RATE_LIMIT=20
# GNANI_STT_USER_RATE_LIMIT=20
# GNANI_RATE_WINDOW_MS=60000
