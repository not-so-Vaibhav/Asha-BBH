{
  "name": "asha-sakhi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,VITE \"node server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "start": "node server/index.mjs",
    "start:prod": "npm run build && npm run start",
    "dev:e2e": "concurrently -k -n API,VITE \"node server/index.mjs\" \"vite --host 127.0.0.1 --port 4173 --strictPort\""
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^18.0.10",
    "framer-motion": "^11.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.14",
    "ws": "^8.23.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vitest": "^2.1.8"
  }
}
